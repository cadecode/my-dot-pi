# ============================================
# agent/ 目录 .gitignore
# 原则：配置入仓库，凭证/状态/缓存/二进制不入库
# ============================================

# === 密钥 / 凭证（绝对不要提交） ===
auth.json
models.json
models-store.json
trust.json
# 含 Bearer token，不入库
mcp.json
mcp-cache.json
# pi-web-access 搜索配置，含各 provider 的 API Key
web-search.json

# === 搜索内容缓存（含检索结果正文） ===
web-search-cache/

# === 本机状态 / 个人偏好 ===
pi-goal.json
pi-statusline.json
pi-subagents.json
multimodal-proxy.json
pi-subagents-state/
pi-cache-optimizer-stats.json
pi-cache-optimizer-stats.d/

# === 会话数据（隐私敏感） ===
sessions/

# === 临时文件 ===
*.tmp
*.log

# === 二进制文件 ===
bin/

# === 依赖目录 ===
node_modules/
npm/node_modules/

# === 操作系统 / IDE ===
.DS_Store
Thumbs.db
Desktop.ini
