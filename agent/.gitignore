# ============================================
# agent/ 目录 .gitignore
# ============================================

# === 密钥 / 凭证（绝对不要提交） ===
auth.json
models.json
models-store.json
pi-goal.json

# === 用户配置（个人偏好，无需分享） ===
multimodal-proxy.json
pi-statusline.json
trust.json
mcp.json
mcp-cache.json

# === 子代理状态 ===
pi-subagents-state/

# === 运行日志 / 会话数据（隐私敏感） ===
sessions/

# === 用量统计（含 session ID） ===
pi-cache-optimizer-stats.json

# === 二进制文件 ===
bin/

# === 依赖目录 ===
node_modules/
npm/node_modules/

# === 操作系统文件 ===
.DS_Store
Thumbs.db
Desktop.ini
